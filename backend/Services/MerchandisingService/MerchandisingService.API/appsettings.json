{
  "Security": {
    "EnforceTenant": true,
    "RequireCompanyHeaderForScopedUsers": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://127.0.0.1:3000"
    ]
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "Erp.Platform",
    "AccessTokenMinutes": 1440,
    "RefreshTokenDays": 7,
    "SigningKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_32+"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "erp.events",
    "MerchandisingQueue": "merchandising-service",
    "DisableConsumers": false
  },
  "Database": {
    "AutoMigrate": false,
    "UseInMemory": false
  },
  "Services": {
    "CompanyService": "http://localhost:5104",
    "InventoryService": "http://localhost:5110",
    "ProcurementService": "http://localhost:5120",
    "ProductionService": "http://localhost:5130",
    "ShipmentService": "http://localhost:5140"
  },
  "AllowedHosts": "*"
}
