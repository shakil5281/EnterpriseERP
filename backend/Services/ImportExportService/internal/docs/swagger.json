{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Bulk import/export microservice for EnterpriseERP (Excel, CSV). Supports preview/confirm import, templates, and job history.",
        "title": "ImportExportService API",
        "contact": {
            "name": "EnterpriseERP Platform Team"
        },
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/import-export/export-jobs": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "export-jobs"
                ],
                "summary": "List export jobs",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseExportJobList"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/export-jobs/{id}/download": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "export-jobs"
                ],
                "summary": "Download export file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job id (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/export/{module}": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Generate Excel or CSV export for the module. PDF is not supported.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                ],
                "tags": [
                    "export"
                ],
                "summary": "Export data",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Module name",
                        "name": "module",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Export options",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.ExportRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/import-jobs": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "import-jobs"
                ],
                "summary": "List import jobs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by module",
                        "name": "module",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseImportJobList"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/import-jobs/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "import-jobs"
                ],
                "summary": "Get import job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job id (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseImportJob"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/import-jobs/{id}/error-file": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                ],
                "tags": [
                    "import-jobs"
                ],
                "summary": "Download import error file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job id (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/import/{module}/confirm": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Commit a preview session as an import job (sync or queued for large files).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "import"
                ],
                "summary": "Confirm import",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Module name",
                        "name": "module",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Preview session id",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_enterprise-erp_importexport_internal_dto.ConfirmImportRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseImportJob"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/import/{module}/preview": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Upload an Excel file, validate rows, and return a preview session. Modules: employee, attendance, payroll, shift, leave.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "import"
                ],
                "summary": "Preview import file",
                "parameters": [
                    {
                        "enum": [
                            "employee",
                            "attendance",
                            "payroll",
                            "shift",
                            "leave"
                        ],
                        "type": "string",
                        "description": "Module name",
                        "name": "module",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Excel (.xlsx) file",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseImportPreview"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/api/v1/import-export/templates/{module}/download": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns an Excel template for employee, attendance, or payroll imports.",
                "produces": [
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                ],
                "tags": [
                    "templates"
                ],
                "summary": "Download import template",
                "parameters": [
                    {
                        "enum": [
                            "employee",
                            "attendance",
                            "payroll"
                        ],
                        "type": "string",
                        "description": "Module name",
                        "name": "module",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseError"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Liveness probe and SQL Server ping.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_handlers.APIResponseHealth"
                        }
                    }
                }
            }
        }
    },
