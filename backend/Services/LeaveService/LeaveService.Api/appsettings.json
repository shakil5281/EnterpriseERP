{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "erp",
    "Password": "erp_dev_password",
    "ExchangeName": "erp.events"
  },
  "Services": {
    "Hr": {
      "BaseUrl": "http://127.0.0.1:5035"
    },
    "Attendance": {
      "BaseUrl": "http://127.0.0.1:5037"
    },
    "Payroll": {
      "BaseUrl": "http://127.0.0.1:5039"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "erp_auth_service",
    "Audience": "erp_platform",
    "SigningKey": "super_secret_key_that_is_at_least_32_characters"
  }
}
