{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5173",
      "http://localhost:3001",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:3001"
    ]
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "erp",
    "Password": "erp_dev_password",
    "ExchangeName": "erp.events",
    "Exchange": "erp.payroll"
  },
  "Services": {
    "Hr": { "BaseUrl": "http://127.0.0.1:5000" },
    "Attendance": { "BaseUrl": "http://127.0.0.1:5000" },
    "Payroll": { "BaseUrl": "http://127.0.0.1:5000" },
    "EmployeeService": "http://127.0.0.1:5000",
    "AttendanceService": "http://127.0.0.1:5000",
    "LeaveService": "http://127.0.0.1:5000",
    "CompanyService": "http://127.0.0.1:5000",
    "NotificationService": "http://127.0.0.1:5000"
  },
  "Database": {
    "AutoMigrate": false
  },
  "PlatformHost": {
    "RunLeaveDatabaseMigration": true,
    "SkipServiceDatabaseMigrations": false
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "Erp.Platform",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SigningKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_32+"
  },
  "Auth": {
    "AllowSelfRegistration": false
  },
  "ReverseProxy": {
    "Routes": {},
    "Clusters": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
